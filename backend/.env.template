# 猫眼服务中台 - 环境变量模板
PORT=8080

# Supabase PostgreSQL 连接
DB_DSN=host=aws-0-xx.pooler.supabase.com user=postgres password=your_password dbname=postgres port=6543 sslmode=require

# SMTP 邮件配置
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your_email@qq.com
SMTP_PASS=your_smtp_password

# JWT 密钥
JWT_SECRET=change-this-in-production

# 猫眼爬取配置
MAOYAN_FETCH_INTERVAL_MIN=30
MAOYAN_REQUEST_DELAY_MIN=1.0
MAOYAN_REQUEST_DELAY_MAX=2.0
